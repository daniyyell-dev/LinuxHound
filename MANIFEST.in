include LICENSE NOTICE README.md GUIDE.md pyproject.toml
recursive-include linuxhound *.py *.html *.css *.js
include linuxhound/models/demo-path.safetensors linuxhound/models/demo-path.json
prune artifacts
prune examples
prune validation
prune tests
prune docs
prune scripts
include images/screenshots/attack-path.jpg images/screenshots/graph-neural-network.jpg
include images/linuxhound-mark.svg images/linuxhound-logo.svg images/linuxhound-logo-dark.svg
include images/screenshots/environment-overview.jpg images/screenshots/root-relationships.jpg
include images/screenshots/file-relationships.jpg images/screenshots/filesystem-relationships.jpg
prune .git
global-exclude __pycache__ *.py[cod] .DS_Store
